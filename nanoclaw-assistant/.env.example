# =============================================================================
# NanoClaw Assistant — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- Required: Claude API (LLM) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Required: Groq API (STT — Free Tier) ---
GROQ_API_KEY=gsk_xxxxx

# --- Required: Google Cloud TTS ---
# Path to service account JSON on the VM
GOOGLE_APPLICATION_CREDENTIALS=/opt/nanoclaw/config/gcp-service-account.json

# --- Optional: ElevenLabs (Premium TTS) ---
# ELEVENLABS_API_KEY=el_xxxxx
# ELEVENLABS_VOICE_ID=xxxxx

# --- Optional: Telegram Bot ---
# TELEGRAM_BOT_TOKEN=123456:ABC-xxxxx

# --- Optional: Todoist (Task Management MCP) ---
# Get your token at: https://app.todoist.com/prefs/integrations (API token section)
# TODOIST_API_TOKEN=4b673a307axxxxxxxxxx

# --- Optional: Roam Research (MCP) ---
# Get API token at: https://roamresearch.com/#/app → Settings → API Tokens (read+edit)
# ROAM_API_TOKEN=roam-xxxxx
# ROAM_GRAPH_NAME=your-graph-name

# --- Optional: Gmail (MCP, OAuth-based) ---
# Credentials stored at ~/.gmail-mcp/ (not in .env)
# Setup: python setup_gmail_oauth.py → SCP to VM → setup-gmail.sh --install-from-tmp

# --- Optional: Google Sheets (MCP, OAuth-based) ---
# Credentials stored at ~/.gsheets-mcp/ (not in .env)
# Setup: python setup_gsheets_oauth.py → SCP to VM → setup-gsheets.sh --install-from-tmp

# --- NanoClaw Configuration ---
ASSISTANT_NAME=Nano
# Set to true if the bot has its own WhatsApp number (not shared with personal)
ASSISTANT_HAS_OWN_NUMBER=false

# --- Memory Optimization (e2-micro) ---
MAX_CONCURRENT_CONTAINERS=1
CONTAINER_TIMEOUT=300000

# --- Voice Middleware ---
# TTS provider: "google" (free) or "elevenlabs" (premium)
TTS_PROVIDER=google
# Google TTS voice name
GOOGLE_TTS_VOICE=de-DE-Standard-B
# Speaking rate (0.5 = slow, 1.0 = normal, 2.0 = fast)
GOOGLE_TTS_SPEAKING_RATE=1.0
# STT language hint
STT_LANGUAGE=de

# --- Security (K1/H6) ---
# Comma-separated phone numbers allowed to interact (without @s.whatsapp.net)
# Leave empty or remove to disable allowlist (allow all senders)
ALLOWED_SENDERS=4917XXXXXXXX
# Max messages per sender per minute (rate limiting)
RATE_LIMIT_MAX_PER_MIN=10
