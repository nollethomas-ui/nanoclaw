[Unit]
Description=NanoClaw AI Assistant (WhatsApp + Telegram Voice Bot)
Documentation=https://github.com/nollethomas-ui/nanoclaw
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nanoclaw
Group=nanoclaw
WorkingDirectory=/opt/nanoclaw/nanoclaw

# Fetch secrets from Secret Manager at service start (K5: no static secrets on disk)
# + prefix = run as root (required for snap gcloud + Secret Manager access)
# External script handles required vs optional secrets gracefully
ExecStartPre=+/bin/bash /opt/nanoclaw/nanoclaw/nanoclaw-assistant/deploy/fetch-secrets.sh
ExecStartPre=+/bin/bash /opt/nanoclaw/nanoclaw/nanoclaw-assistant/deploy/refresh-oauth-tokens.sh

# Static config (non-secret settings)
EnvironmentFile=/opt/nanoclaw/nanoclaw/.env
# Runtime secrets from Secret Manager (overrides .env values)
# - prefix = don't fail if file doesn't exist yet
EnvironmentFile=-/run/nanoclaw/secrets.env

# Memory optimization for e2-micro (1GB RAM)
Environment=MAX_CONCURRENT_CONTAINERS=2
Environment=CONTAINER_TIMEOUT=300000
Environment=NODE_OPTIONS=--max-old-space-size=256

# Start NanoClaw
ExecStart=/usr/bin/node dist/index.js

# Auto-restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nanoclaw

# Security hardening (H4)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/nanoclaw
ReadWritePaths=/run/nanoclaw
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/nanoclaw/.gmail-mcp
ReadWritePaths=/home/nanoclaw/.gsheets-mcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=false
RestrictSUIDSGID=true
MemoryMax=512M
CPUQuota=80%

# Transient runtime directory for secrets (auto-cleaned on stop)
RuntimeDirectory=nanoclaw
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
